{
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run format*)",
      "Bash(npm run type-check*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run test*)",
      "Bash(npm run i18n:*)",
      "Bash(npm run migration:lint*)",
      "Bash(npm run build*)",
      "Bash(npm ci*)",
      "Bash(npm install*)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(npx vitest *)",
      "Bash(npx eslint *)",
      "Bash(npx prettier *)",
      "Bash(node scripts/check-*)",
      "Bash(scripts/verify-schema.sh*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git add*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-reliable-tests.mjs"
          }
        ]
      }
    ]
  }
}
