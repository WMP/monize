{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*[.-]spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "<rootDir>/scripts/esm-interop-transformer.cjs",
      {
        "tsconfig": {
          "isolatedModules": true,
          "module": "commonjs",
          "moduleResolution": "bundler"
        },
        "diagnostics": {
          "ignoreCodes": [151002]
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@scure|@otplib|otplib|@noble|openid-client|oauth4webapi|jose|uuid|mdb-reader|@nestjs)/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1
}
