{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": "test/.*[.-]spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^\\.{1,2}/(.*/)?typeorm-compat\\.js$": "<rootDir>/src/test-helpers/nestjs-typeorm-compat.ts"
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(@scure|@otplib|otplib|@noble|openid-client|oauth4webapi|jose|uuid|mdb-reader|@nestjs/passport|@nestjs/jwt|@nestjs/typeorm)/)"
  ],
  "testEnvironment": "node",
  "testTimeout": 30000,
  "maxWorkers": 1
}
